# Copy to backend/.env and adjust as needed.

# Development database — the app reads/writes here.
DATABASE_URL=postgresql+psycopg://lenny:lenny@localhost:5432/lenny_growth_assistant

# Dedicated database used only by the pytest suite (backend/tests/conftest.py).
# Must resolve to a different database name than DATABASE_URL — tests refuse
# to run otherwise. Created automatically by deployment/init/02-create-test-db.sql
# the first time `docker compose up -d` initializes the Postgres volume.
TEST_DATABASE_URL=postgresql+psycopg://lenny:lenny@localhost:5432/lenny_growth_assistant_test

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

HARNESS_TIMEOUT_SECONDS=30
